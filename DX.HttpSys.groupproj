<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{AA4C1C4F-80A2-42FA-9249-605CCE435C8B}</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <Projects Include="src\DX.HttpSys.Core.dproj">
      <Dependencies/>
    </Projects>
    <!-- DX.HttpSys.WiRL is intentionally NOT in the build group: WiRL is an
         external dependency that is not vendored here. Add it to a local group
         once WiRL is on the library path. See docs/DECISIONS.md (A-10). The
         same applies to the WiRL and Horse demos (demo\02.WiRL, demo\04.Horse):
         they are source-only showcases without .dproj files and are built via
         the optional integration harness (tests-integration\) instead. -->
    <Projects Include="src\DX.HttpSys.WebBroker.dproj">
      <Dependencies>src\DX.HttpSys.Core.dproj</Dependencies>
    </Projects>
    <Projects Include="tests\DX.HttpSys.Tests.dproj">
      <Dependencies>src\DX.HttpSys.Core.dproj</Dependencies>
    </Projects>
    <Projects Include="demo\01.StandaloneServer\StandaloneServer.dproj">
      <Dependencies>src\DX.HttpSys.Core.dproj</Dependencies>
    </Projects>
    <Projects Include="demo\03.WebBroker\WebBrokerDemo.dproj">
      <Dependencies>src\DX.HttpSys.Core.dproj</Dependencies>
    </Projects>
    <Projects Include="demo\07.Sse\SseDemo.dproj">
      <Dependencies>src\DX.HttpSys.Core.dproj</Dependencies>
    </Projects>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Default.Personality.12</Borland.Personality>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
